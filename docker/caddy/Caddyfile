{
	# Local development only: issue certificates from Caddy's internal CA.
	local_certs
	auto_https disable_redirects
}

http://{$CADDY_SITE_ADDRESS:laravel.test}, https://{$CADDY_SITE_ADDRESS:laravel.test} {
	tls internal

	encode zstd gzip

	# Reverb. The browser is on https, so pusher-js insists on wss; terminate
	# TLS here and hand the socket to Reverb in the clear. /app is the client
	# socket, /apps the server-side publishing API.
	@reverb path /app/* /apps/*
	reverse_proxy @reverb laravel.test:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	reverse_proxy laravel.test:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}

# Vite's dev server speaks plain HTTP, so an HTTPS page blocks its module
# scripts as mixed content. Terminate TLS here too and hand the request to
# Vite in the clear. Port 5173 stays published by the app container for the
# plain-HTTP case (the LAN box), so this listens on its own port.
https://{$CADDY_SITE_ADDRESS:laravel.test}:{$VITE_TLS_PORT:5174} {
	tls internal

	reverse_proxy laravel.test:5173 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
